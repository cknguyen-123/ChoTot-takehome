# Copy to .env only if you want to override defaults. Never commit .env.
# `make run` works without any of these.

# Host port for the API (docker compose publishes it). Default 8080.
PORT=8080

# debug | info | warn | error
LOG_LEVEL=info

# Seconds-scale tuning; defaults are fine for local runs.
SHUTDOWN_TIMEOUT_MS=10000
READINESS_CHECK_TIMEOUT_MS=2000

# Set by docker-compose.yml for the api container; only needed when running Node directly.
DATABASE_URL=postgres://moderation:moderation@localhost:5432/moderation

# Maximum database connections per process. Default 10.
DB_POOL_MAX=10
